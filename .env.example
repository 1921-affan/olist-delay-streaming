# ---------------------------------------------------------------- Kafka
# Inside Docker every service talks to kafka:9092.
# From your laptop (scripts, Kafka tools) use localhost:9094 so it never clashes
# with a locally installed Kafka on 9092.
KAFKA_BOOTSTRAP=kafka:9092
TOPIC_ORDERS=orders
TOPIC_SHIPMENT_EVENTS=shipment-events
TOPIC_PREDICTIONS=delay-predictions
TOPIC_ALERTS=alerts
TOPIC_PARTITIONS=3  

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me

# ---------------------------------------------------------------- Replay
# REPLAY_SPEED = simulated seconds per real second. 1440 = 1 simulated day per real minute.
REPLAY_SPEED=1440
# Start a little after 1 May so the stream looks realistic from the first minute.
REPLAY_START=2018-05-20
REPLAY_END=2018-10-31
DATA_ORDERS=/app/data/orders_stream.csv
DATA_EVENTS=/app/data/shipment_events_enriched.csv
PRODUCER_CHECKPOINT=/app/state/producer_checkpoint.json

# ---------------------------------------------------------------- Models and rules
MODEL1_PATH=/app/models/model1_production_XGB_12.joblib
MODEL3_PATH=/app/models/model3_production.joblib
R1_APPROVAL_HOURS=24
R5_PROMISE_DAYS=10
R6_DISTANCE_KM=1000
R7_SELLER_LATE_RATE=0.15
R7_SELLER_MIN_ORDERS=20

# ---------------------------------------------------------------- Window aggregator
WINDOW_GRACE_HOURS=6
R8_LATE_RATE=0.15
R8_MIN_DELIVERIES=50
R8_ROLLING_DAYS=7
AGG_CHECKPOINT_SECONDS=5

# ---------------------------------------------------------------- DB writer
DB_BATCH_SIZE=500
DB_BATCH_SECONDS=1.0

# ---------------------------------------------------------------- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
