  {
   "id": 11,
   "type": "table",
   "title": "States \u2014 last 7 simulated days (1-day tumbling windows)",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT w.customer_state AS state, SUM(w.orders_placed) AS placed, SUM(w.handoffs) AS handoffs, SUM(w.deliveries) AS delivered, SUM(w.late_deliveries) AS late, ROUND((SUM(w.late_deliveries)::numeric / NULLIF(SUM(w.deliveries), 0)) * 100, 1) AS \"late rate %\", ROUND((SUM(w.avg_m1_probability * w.orders_placed) / NULLIF(SUM(w.orders_placed), 0) * 100)::numeric, 1) AS \"avg Model 1 %\", ROUND((SUM(w.avg_m3_probability * w.handoffs) / NULLIF(SUM(w.handoffs), 0) * 100)::numeric, 1) AS \"avg Model 3 %\", SUM(w.m1_alerts + w.m3_alerts) AS alerts FROM state_daily_windows w, v_sim_now n WHERE w.window_start >= date_trunc('day', n.sim_now) - INTERVAL '7 days' GROUP BY 1 ORDER BY \"late rate %\" DESC NULLS LAST, delivered DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
