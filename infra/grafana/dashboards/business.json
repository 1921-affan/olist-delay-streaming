     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT order_id, customer_state AS state, current_stage AS stage, late_prob_pct AS \"late %\", model1_pct AS \"Model 1 %\", model3_pct AS \"Model 3 %\", reasons, to_char(estimated_delivery_date, 'YYYY-MM-DD') AS promised FROM v_live_risk ORDER BY late_prob_pct DESC NULLS LAST, last_event_time DESC LIMIT 20"
