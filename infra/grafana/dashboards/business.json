     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT to_char(event_time, 'MM-DD HH24:MI') AS sim_time, alert_type, severity, COALESCE(order_id, '\u2014') AS order_id, customer_state AS state, stage, ROUND((score * 100)::numeric, 1) AS \"score %\", array_to_string(reasons, ', ') AS reasons FROM alerts ORDER BY event_time DESC, processed_at DESC LIMIT 25"
