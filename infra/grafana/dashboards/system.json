{
 "uid": "olist-system",
 "title": "Olist delivery-delay \u2014 system view",
 "description": "Real time. Prometheus metrics from our services + Kafka lag exporter.",
 "tags": [
  "olist",
  "kafka"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
